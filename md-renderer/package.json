{
  "name": "md-renderer",
  "version": "1.0.0",
  "description": "Static site generator for markdown using 11ty",
  "main": ".eleventy.js",
  "scripts": {
    "build": "eleventy",
    "dev": "eleventy --serve",
    "watch": "eleventy --watch"
  },
  "keywords": [
    "11ty",
    "eleventy",
    "markdown",
    "static-site-generator"
  ],
  "author": "Jody Tate",
  "license": "MIT",
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.0"
  },
  "dependencies": {
    "markdown-it": "^14.0.0"
  }
}
