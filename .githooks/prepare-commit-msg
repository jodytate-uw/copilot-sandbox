#!/bin/sh
# Safety net: add the AI-transparency trailers when Copilot produced the change.
# Commits made without Copilot carry no trailers at all.

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="$2"

# Skip merges, squashes, and reworded/amended messages that already exist verbatim.
case "$COMMIT_SOURCE" in
    merge|squash) exit 0 ;;
esac

COPILOT="$(git config --get commit.githubCopilot)"
MODEL="$(git config --get commit.llmModel)"

case "$COPILOT" in
    true|True|TRUE|yes|1) ;;
    *) exit 0 ;;
esac

[ -z "$MODEL" ] && MODEL="Unspecified"

if ! grep -qi '^GitHub-Copilot:' "$COMMIT_MSG_FILE"; then
    git interpret-trailers --in-place --trailer "GitHub-Copilot: true" "$COMMIT_MSG_FILE"
fi

if ! grep -qi '^LLM-Model:' "$COMMIT_MSG_FILE"; then
    git interpret-trailers --in-place --trailer "LLM-Model: $MODEL" "$COMMIT_MSG_FILE"
fi
